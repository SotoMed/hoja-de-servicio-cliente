    async function generatePDF() {
      try {
        saveReport();
        updateQR();
      } catch (err) {
        console.error('Error al guardar antes del PDF:', err);
      }
      if (!window.jspdf || !window.jspdf.jsPDF) {
        generatePrintablePDF();
        return;
      }
      const data = collectData();
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF('p', 'mm', 'a4');
      const pageW = 210, pageH = 297;
      const margin = 14;
      let y = 16;
      const primary = [18, 52, 77];
      const accent = [39, 166, 183];
      const soft = [232, 246, 248];
      const line = [210, 220, 230];
      const text = [31, 41, 55];

      function addFooter() {
        const page = doc.internal.getNumberOfPages();
        doc.setFontSize(8);
        doc.setTextColor(110, 120, 130);
        doc.text(`${data.companyName || 'Servicio técnico'} · ${data.companyPhone || ''} · ${data.companyEmail || ''}`, margin, pageH - 8);
        doc.text(`Página ${page}`, pageW - margin, pageH - 8, { align: 'right' });
      }

      function newPage() {
        addFooter();
        doc.addPage();
        y = 16;
      }

      function ensureSpace(h) {
        if (y + h > pageH - 16) newPage();
      }

      function header() {
        doc.setFillColor(...primary);
        doc.roundedRect(margin, y, pageW - margin * 2, 33, 3, 3, 'F');
        doc.setTextColor(255,255,255);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(16);
        doc.text('Reporte de Servicio Técnico', margin + 5, y + 10);
        doc.setFontSize(9);
        doc.setFont('helvetica','normal');
        doc.text(data.companyName || 'Empresa de servicio', margin + 5, y + 17);
        doc.text(data.companyTagline || 'Servicio de Ingeniería', margin + 5, y + 23);
        doc.setFont('helvetica','bold');
        doc.setFontSize(10);
        doc.text(`Folio: ${data.folio || ''}`, pageW - margin - 5, y + 10, { align: 'right' });
        doc.setFont('helvetica','normal');
        doc.text(`Fecha: ${data.reportDate || ''}`, pageW - margin - 5, y + 17, { align: 'right' });
        if (data.logoDataUrl) {
          try { doc.addImage(data.logoDataUrl, 'PNG', pageW - margin - 27, y + 20, 20, 10, undefined, 'FAST'); } catch {}
        }
        y += 40;
      }

      function sectionTitle(title) {
        ensureSpace(12);
        doc.setFillColor(...soft);
        doc.setDrawColor(...line);
        doc.roundedRect(margin, y, pageW - margin * 2, 8, 2, 2, 'FD');
        doc.setTextColor(...primary);
        doc.setFont('helvetica','bold');
        doc.setFontSize(10);
        doc.text(title, margin + 4, y + 5.5);
        y += 11;
      }

      function labelValue(label, value, x, width) {
        doc.setFontSize(7.5);
        doc.setTextColor(100, 110, 120);
        doc.setFont('helvetica','bold');
        doc.text(label, x, y);
        doc.setFontSize(9);
        doc.setTextColor(...text);
        doc.setFont('helvetica','normal');
        const lines = doc.splitTextToSize(value || '-', width);
        doc.text(lines, x, y + 4.2);
        return 6 + (lines.length * 4);
      }

      function twoColRows(items) {
        for (let i = 0; i < items.length; i += 2) {
          ensureSpace(16);
          const left = items[i];
          const right = items[i+1];
          const startY = y;
          const h1 = labelValue(left[0], left[1], margin, 82);
          let h2 = 0;
          if (right) h2 = labelValue(right[0], right[1], margin + 94, 82);
          y = startY + Math.max(h1, h2, 13);
          doc.setDrawColor(235, 238, 242);
          doc.line(margin, y - 2, pageW - margin, y - 2);
        }
      }

      function paragraph(title, body) {
        sectionTitle(title);
        doc.setTextColor(...text);
        doc.setFont('helvetica','normal');
        doc.setFontSize(9);
        const lines = doc.splitTextToSize(body || '-', pageW - margin * 2);
        const lineH = 4.4;
        for (const line of lines) {
          ensureSpace(lineH + 2);
          doc.text(line, margin, y);
          y += lineH;
        }
        y += 4;
      }

      function partsTable(parts) {
        sectionTitle('Refacciones y consumibles utilizados');
        const colX = [margin, margin + 78, margin + 103, margin + 125];
        const colW = [78, 25, 22, 57];
        ensureSpace(12);
        doc.setFillColor(...primary);
        doc.setTextColor(255,255,255);
        doc.setFont('helvetica','bold'); doc.setFontSize(8);
        ['Descripción','Cantidad','Unidad','Observaciones'].forEach((h,i) => doc.text(h, colX[i] + 2, y + 5));
        y += 8;
        doc.setFont('helvetica','normal'); doc.setTextColor(...text);
        if (!parts.length) parts = [{description:'Sin refacciones registradas', qty:'', unit:'', notes:''}];
        parts.forEach(p => {
          const cells = [p.description || '-', p.qty || '-', p.unit || '-', p.notes || '-'];
          const lines = cells.map((c,i) => doc.splitTextToSize(c, colW[i] - 4));
          const rowH = Math.max(8, ...lines.map(l => l.length * 4 + 4));
          ensureSpace(rowH + 2);
          doc.setDrawColor(...line);
          doc.rect(margin, y, pageW - margin*2, rowH);
          lines.forEach((l,i) => doc.text(l, colX[i] + 2, y + 5));
          y += rowH;
        });
        y += 4;
      }

      function evidence(photosArr) {
        sectionTitle('Evidencia fotográfica');
        if (!photosArr.length) {
          doc.setFontSize(9); doc.setTextColor(...text); doc.text('Sin evidencia fotográfica cargada.', margin, y); y += 8; return;
        }
        const imgW = 82, imgH = 58, gap = 12;
        let x = margin;
        for (let i = 0; i < photosArr.length; i++) {
          ensureSpace(imgH + 16);
          const p = photosArr[i];
          try { doc.addImage(p.dataUrl, 'JPEG', x, y, imgW, imgH, undefined, 'FAST'); }
          catch { try { doc.addImage(p.dataUrl, 'PNG', x, y, imgW, imgH, undefined, 'FAST'); } catch {} }
          doc.setFontSize(7.5); doc.setTextColor(100, 110, 120);
          const cap = doc.splitTextToSize(p.caption || p.name || `Evidencia ${i+1}`, imgW);
          doc.text(cap.slice(0,2), x, y + imgH + 4);
          if (x + imgW + gap + imgW > pageW - margin) { x = margin; y += imgH + 15; }
          else x += imgW + gap;
        }
        if (x !== margin) y += imgH + 16;
      }

      function signatures() {
        sectionTitle('Firmas de conformidad');
        ensureSpace(45);
        const sigW = 76, sigH = 28;
        doc.setDrawColor(...line);
        doc.roundedRect(margin, y, sigW, 38, 2, 2, 'S');
        doc.roundedRect(pageW - margin - sigW, y, sigW, 38, 2, 2, 'S');
        try { doc.addImage(data.techSignature, 'PNG', margin + 5, y + 3, sigW - 10, sigH, undefined, 'FAST'); } catch {}
        try { doc.addImage(data.clientSignature, 'PNG', pageW - margin - sigW + 5, y + 3, sigW - 10, sigH, undefined, 'FAST'); } catch {}
        doc.setFontSize(8); doc.setTextColor(...text); doc.setFont('helvetica','bold');
        doc.text(data.preparedBy || 'Ingeniero de servicio', margin + sigW/2, y + 34, { align: 'center' });
        doc.text(data.clientReceiver || 'Responsable del cliente', pageW - margin - sigW/2, y + 34, { align: 'center' });
        doc.setFont('helvetica','normal'); doc.setTextColor(100,110,120);
        doc.text('Firma de ingeniero de servicio', margin + sigW/2, y + 42, { align: 'center' });
        doc.text('Firma de conformidad del cliente', pageW - margin - sigW/2, y + 42, { align: 'center' });
        y += 50;
      }

      header();
      const qrData = getQRDataUrl('reportQR');
      if (qrData) {
        doc.setTextColor(...primary); doc.setFontSize(7); doc.setFont('helvetica','bold');
        doc.text('Validación QR', pageW - margin - 25, y - 1, { align: 'center' });
        try { doc.addImage(qrData, 'PNG', pageW - margin - 31, y + 1, 24, 24, undefined, 'FAST'); } catch {}
      }

      sectionTitle('Resumen ejecutivo del servicio');
      twoColRows([
        ['Cliente', data.clientName], ['Equipo', `${data.brand || ''} ${data.model || ''}`.trim()],
        ['Servicio', data.serviceType], ['Estado final', data.finalStatus],
        ['Inicio', formatDateTime(data.startTime)], ['Término', formatDateTime(data.endTime)],
        ['Próximo mantenimiento', data.nextMaintenance], ['Puntuación / avance', data.score]
      ]);

      sectionTitle('Datos del cliente');
      twoColRows([
        ['Nombre del cliente', data.clientName], ['Responsable que recibe', data.clientReceiver],
        ['Domicilio', data.clientAddress], ['Lugar del servicio', data.servicePlace],
        ['Teléfono', data.clientPhone], ['Correo', data.clientEmail],
        ['Ubicación / área', data.clientLocation], ['Preparado por', data.preparedBy]
      ]);

      sectionTitle('Datos del equipo');
      twoColRows([
        ['Instrumento / área', data.instrument], ['Marca', data.brand],
        ['Modelo', data.model], ['Número de serie', data.serial],
        ['Tipo de servicio', data.serviceType], ['Prioridad', data.priority]
      ]);

      paragraph('Reporte de falla y/o motivo del servicio', data.problemReport);
      paragraph('Descripción del servicio realizado', data.serviceDescription);
      partsTable(data.parts || []);
      paragraph('Observaciones y recomendaciones', data.observations);
      evidence(data.photos || []);
      signatures();
      addFooter();

      const filename = `Reporte_${safeName(data.folio || 'sin_folio')}_${safeName(data.clientName || 'cliente')}.pdf`;
      doc.save(filename);
      toast('PDF generado.');
    }

    function exportExcel() {
      const reports = loadReports();
      if (!reports.length) { toast('No hay reportes guardados para exportar.'); return; }
      const rows = reports.map(r => ({
        Folio: r.folio || '',
        Fecha: r.reportDate || '',
        Cliente: r.clientName || '',
        Responsable: r.clientReceiver || '',
        Telefono: r.clientPhone || '',
        Correo: r.clientEmail || '',
        Domicilio: r.clientAddress || '',
        Instrumento: r.instrument || '',
        Marca: r.brand || '',
        Modelo: r.model || '',
        Serie: r.serial || '',
        TipoServicio: r.serviceType || '',
        EstadoFinal: r.finalStatus || '',
        Inicio: r.startTime || '',
        Termino: r.endTime || '',
        ProximoMantenimiento: r.nextMaintenance || '',
        PreparadoPor: r.preparedBy || '',
        Refacciones: (r.parts || []).map(p => `${p.description || ''} (${p.qty || ''} ${p.unit || ''})`).join('; '),
        CantidadFotos: (r.photos || []).length,
        Motivo: r.problemReport || '',
        ServicioRealizado: r.serviceDescription || '',
        Observaciones: r.observations || '',
        Actualizado: r.updatedAt || ''
      }));
      if (window.XLSX && XLSX.utils) {
        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.json_to_sheet(rows);
        ws['!cols'] = Object.keys(rows[0]).map(k => ({ wch: Math.min(Math.max(k.length + 4, 14), 35) }));
        XLSX.utils.book_append_sheet(wb, ws, 'Reportes');
        XLSX.writeFile(wb, `Base_Datos_Reportes_${todayDate()}.xlsx`);
        toast('Base de datos Excel exportada.');
        return;
      }
      const headers = Object.keys(rows[0]);
      const escapeCell = v => '"' + String(v ?? '').replace(/"/g, '""') + '"';
      const csv = [headers.map(escapeCell).join(','), ...rows.map(row => headers.map(h => escapeCell(row[h])).join(','))].join('\n');
      const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `Base_Datos_Reportes_${todayDate()}.csv`;
      a.click();
      URL.revokeObjectURL(a.href);
      toast('No cargó la librería Excel en línea; se exportó CSV compatible con Excel.');
    }

    function exportJsonBackup() {
      const payload = { settings: loadSettings(), reports: loadReports(), exportedAt: new Date().toISOString() };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `Respaldo_Reportes_Completo_${todayDate()}.json`;
      a.click();
      URL.revokeObjectURL(a.href);
    }

    $('companyLogo').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      logoDataUrl = await compressImage(file, 600, 0.8);
      storeSettings();
      toast('Logo guardado en configuración local.');
    });

    fields.forEach(id => {
      document.addEventListener('input', (e) => {
        if (e.target && e.target.id === id) { updateStatus(); if (['folio','clientName','brand','model','serial','reportDate','finalStatus','publicUrl'].includes(id)) updateQR(); }
      });
    });

    // Mobile signing mode
    function initMobileSignMode() {
      const params = new URLSearchParams(location.search);
      if (!params.has('mobileSign')) return false;
      $('normalApp').style.display = 'none';
      $('mobileSignApp').style.display = 'block';
      $('mobileFolio').value = params.get('folio') || '';
      setupSignatureCanvas('mobileSignature');
      return true;
    }

    function clearMobileSignature() { clearCanvas('mobileSignature'); }

    function makeMobileSignatureCode() {
      const obj = {
        folio: $('mobileFolio').value,
        name: $('mobileSignerName').value,
        signedAt: new Date().toISOString(),
        sig: getSignatureData('mobileSignature')
      };
      const raw = JSON.stringify(obj);
      const code = btoa(unescape(encodeURIComponent(raw)));
      $('mobileSignatureCode').value = code;
      navigator.clipboard?.writeText(code).then(() => toast('Código copiado al portapapeles.'));
    }

    function init() {
      if (initMobileSignMode()) return;
      applySettings();
      setupSignatureCanvas('techSignature');
      setupSignatureCanvas('clientSignature');
      fillParts([]);
      renderReportList();
      $('reportDate').value = todayDate();
      $('folio').value = generateFolio();
      $('score').value = '100%';
      updateStatus();
      updateQR();
    }

    init();
  </script>
</body>
</html>
