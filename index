<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sistema de Hojas de Servicio</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    :root {
      --primary: #12344d;
      --primary-2: #1e88a8;
      --accent: #27a6b7;
      --bg: #f4f7fb;
      --card: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --line: #d7dee8;
      --ok: #0f8b5f;
      --danger: #b42318;
      --soft: #e8f6f8;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
    }
    .topbar {
      background: linear-gradient(135deg, var(--primary), var(--primary-2));
      color: white;
      padding: 18px 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      position: sticky;
      top: 0;
      z-index: 10;
      box-shadow: 0 4px 16px rgba(10, 31, 51, 0.18);
    }
    .topbar h1 { margin: 0; font-size: 21px; letter-spacing: .2px; }
    .topbar small { opacity: .9; display: block; margin-top: 4px; }
    .status-pill {
      background: rgba(255,255,255,.14);
      border: 1px solid rgba(255,255,255,.24);
      border-radius: 999px;
      padding: 9px 14px;
      font-size: 13px;
      white-space: nowrap;
    }
    .wrap {
      max-width: 1320px;
      margin: 22px auto;
      padding: 0 16px 40px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 330px;
      gap: 18px;
    }
    .main { min-width: 0; }
    .side { position: sticky; top: 92px; align-self: start; }
    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
      box-shadow: 0 8px 26px rgba(15, 23, 42, 0.06);
      overflow: hidden;
      margin-bottom: 16px;
    }
    .card h2 {
      margin: 0;
      padding: 14px 18px;
      font-size: 16px;
      background: linear-gradient(90deg, #eef9fb, #ffffff);
      border-bottom: 1px solid var(--line);
      color: var(--primary);
    }
    .card-body { padding: 18px; }
    .grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; }
    .col-12 { grid-column: span 12; }
    .col-8 { grid-column: span 8; }
    .col-6 { grid-column: span 6; }
    .col-4 { grid-column: span 4; }
    .col-3 { grid-column: span 3; }
    label { font-size: 12px; font-weight: bold; color: #334155; display: block; margin-bottom: 6px; }
    input, select, textarea {
      width: 100%;
      border: 1px solid #cfd8e3;
      border-radius: 10px;
      padding: 10px 11px;
      font-size: 14px;
      background: white;
      color: var(--text);
      outline: none;
      transition: .18s ease;
    }
    textarea { min-height: 90px; resize: vertical; line-height: 1.35; }
    input:focus, select:focus, textarea:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 4px rgba(39,166,183,.13);
    }
    .btn {
      border: 0;
      border-radius: 11px;
      padding: 11px 13px;
      font-weight: bold;
      cursor: pointer;
      background: var(--primary);
      color: white;
      width: 100%;
      margin-bottom: 10px;
      transition: transform .12s ease, opacity .12s ease;
      font-size: 14px;
    }
    .btn:hover { transform: translateY(-1px); opacity: .96; }
    .btn.secondary { background: #eef2f7; color: #16324f; border: 1px solid #d9e2ed; }
    .btn.accent { background: var(--accent); }
    .btn.ok { background: var(--ok); }
    .btn.danger { background: var(--danger); }
    .btn.small { width: auto; padding: 8px 10px; margin: 0; font-size: 12px; }
    .hint { color: var(--muted); font-size: 12px; line-height: 1.45; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { border: 1px solid var(--line); padding: 9px; text-align: left; vertical-align: top; }
    th { background: #eef7fa; color: var(--primary); }
    td input { border: 0; padding: 6px; border-radius: 6px; }
    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
    .photo-item {
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 10px;
      background: #fbfdff;
    }
    .photo-item img { width: 100%; height: 120px; object-fit: cover; border-radius: 9px; border: 1px solid #e5eaf0; }
    .signature-box {
      border: 1px dashed #9fb3c8;
      border-radius: 14px;
      background: #fbfdff;
      padding: 10px;
    }
    canvas.signature {
      width: 100%;
      height: 180px;
      border-radius: 10px;
      background: white;
      border: 1px solid #d7dee8;
      touch-action: none;
    }
    .qr-box {
      display: flex;
      justify-content: center;
      align-items: center;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 14px;
      min-height: 180px;
      padding: 12px;
      margin: 10px 0;
    }
    .qr-box img, .qr-box canvas { max-width: 160px; max-height: 160px; }
    .report-list { max-height: 260px; overflow-y: auto; border: 1px solid var(--line); border-radius: 12px; }
    .report-row { padding: 10px; border-bottom: 1px solid var(--line); cursor: pointer; background: #fff; }
    .report-row:hover { background: #f2f8fa; }
    .report-row:last-child { border-bottom: none; }
    .report-row strong { display: block; font-size: 13px; }
    .report-row span { font-size: 12px; color: var(--muted); }
    .toast {
      position: fixed;
      right: 20px;
      bottom: 20px;
      background: #0f172a;
      color: white;
      padding: 12px 15px;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,.22);
      display: none;
      z-index: 100;
      max-width: 360px;
    }
    .mobile-sign {
      display: none;
      max-width: 720px;
      margin: 24px auto;
      padding: 0 16px;
    }
    .code-area { font-family: monospace; min-height: 140px; font-size: 11px; }
    .divider { height: 1px; background: var(--line); margin: 14px 0; }
    @media (max-width: 980px) {
      .wrap { grid-template-columns: 1fr; }
      .side { position: static; }
      .col-6, .col-4, .col-3, .col-8 { grid-column: span 12; }
      .topbar { align-items: flex-start; flex-direction: column; }
      .status-pill { white-space: normal; }
    }
    @media print {
      body { background: white; }
      .topbar, .side, .btn, .no-print { display: none !important; }
      .wrap { display: block; max-width: none; margin: 0; padding: 0; }
      .card { break-inside: avoid; box-shadow: none; }
    }
  </style>
</head>
<body>
  <div id="normalApp">
    <header class="topbar">
      <div>
        <h1>Sistema de Hojas de Servicio Técnico</h1>
        <small>Captura de servicio, evidencia, firmas, PDF, Excel y QR</small>
      </div>
      <div class="status-pill" id="currentStatus">Reporte nuevo</div>
    </header>

    <div class="wrap">
      <main class="main">
        <section class="card">
          <h2>1. Configuración de la empresa</h2>
          <div class="card-body grid">
            <div class="col-6">
              <label>Nombre comercial / razón social</label>
              <input id="companyName" placeholder="Ej. Soluciones & Laboratorio" />
            </div>
            <div class="col-6">
              <label>Especialidad / descripción</label>
              <input id="companyTagline" placeholder="Ej. Servicio de Ingeniería" />
            </div>
            <div class="col-4">
              <label>Teléfono</label>
              <input id="companyPhone" placeholder="Teléfono de contacto" />
            </div>
            <div class="col-4">
              <label>Correo</label>
              <input id="companyEmail" placeholder="correo@empresa.com" />
            </div>
            <div class="col-4">
              <label>URL pública del sistema</label>
              <input id="publicUrl" placeholder="https://tusistema.com/index.html" />
            </div>
            <div class="col-8">
              <label>Domicilio</label>
              <input id="companyAddress" placeholder="Dirección de la empresa" />
            </div>
            <div class="col-4">
              <label>Logo de la empresa</label>
              <input id="companyLogo" type="file" accept="image/*" />
            </div>
            <div class="col-12 hint">
              La URL pública sirve para que el QR pueda abrirse desde celular. Si estás usando este archivo como <b>file://</b>, el PDF y Excel sí funcionan, pero el QR de firma móvil necesita que este HTML esté publicado en internet o en una red accesible.
            </div>
          </div>
        </section>

        <section class="card">
          <h2>2. Datos generales del reporte</h2>
          <div class="card-body grid">
            <div class="col-3"><label>Folio</label><input id="folio" /></div>
            <div class="col-3"><label>Fecha del reporte</label><input id="reportDate" type="date" /></div>
            <div class="col-3"><label>Preparado por</label><input id="preparedBy" placeholder="Nombre del ingeniero" /></div>
            <div class="col-3"><label>Estado final</label><select id="finalStatus"><option>Equipo operativo</option><option>Equipo operativo con observaciones</option><option>Equipo no operativo</option><option>Pendiente por refacción</option><option>Pendiente por autorización</option></select></div>
          </div>
        </section>

        <section class="card">
          <h2>3. Datos del cliente</h2>
          <div class="card-body grid">
            <div class="col-6"><label>Nombre del cliente</label><input id="clientName" /></div>
            <div class="col-6"><label>Responsable que recibe / responsable sanitario</label><input id="clientReceiver" /></div>
            <div class="col-8"><label>Domicilio del servicio</label><input id="clientAddress" /></div>
            <div class="col-4"><label>Lugar del servicio</label><select id="servicePlace"><option>Instalaciones del cliente</option><option>Taller del proveedor</option><option>Remoto</option><option>Otro</option></select></div>
            <div class="col-4"><label>Teléfono</label><input id="clientPhone" /></div>
            <div class="col-4"><label>Correo</label><input id="clientEmail" /></div>
            <div class="col-4"><label>Ubicación / área</label><input id="clientLocation" placeholder="Laboratorio, área, ciudad, etc." /></div>
          </div>
        </section>

        <section class="card">
          <h2>4. Datos del equipo</h2>
          <div class="card-body grid">
            <div class="col-4"><label>Instrumento / área</label><input id="instrument" placeholder="Química clínica, hematología, etc." /></div>
            <div class="col-4"><label>Marca</label><input id="brand" /></div>
            <div class="col-4"><label>Modelo</label><input id="model" /></div>
            <div class="col-4"><label>Número de serie</label><input id="serial" /></div>
            <div class="col-4"><label>Tipo de servicio</label><select id="serviceType"><option>Mantenimiento preventivo</option><option>Mantenimiento correctivo</option><option>Instalación</option><option>Diagnóstico</option><option>Capacitación</option><option>Validación</option><option>Otro</option></select></div>
            <div class="col-4"><label>Prioridad</label><select id="priority"><option>Normal</option><option>Alta</option><option>Crítica</option></select></div>
          </div>
        </section>

        <section class="card">
          <h2>5. Datos técnicos del servicio</h2>
          <div class="card-body grid">
            <div class="col-3"><label>Inicio del servicio</label><input id="startTime" type="datetime-local" /></div>
            <div class="col-3"><label>Término del servicio</label><input id="endTime" type="datetime-local" /></div>
            <div class="col-3"><label>Fecha próximo mantenimiento</label><input id="nextMaintenance" type="date" /></div>
            <div class="col-3"><label>Puntuación / avance</label><input id="score" placeholder="100%" /></div>
            <div class="col-12"><label>Reporte de falla y/o motivo del servicio</label><textarea id="problemReport" placeholder="Describe la falla reportada, motivo del servicio o solicitud del cliente"></textarea></div>
            <div class="col-12"><label>Descripción del servicio realizado</label><textarea id="serviceDescription" placeholder="Actividades realizadas, mediciones, ajustes, calibraciones, pruebas, etc."></textarea></div>
            <div class="col-12"><label>Observaciones y recomendaciones</label><textarea id="observations" placeholder="Recomendaciones para operación, seguridad, consumibles, refacciones, seguimiento, etc."></textarea></div>
          </div>
        </section>

        <section class="card">
          <h2>6. Refacciones y consumibles utilizados</h2>
          <div class="card-body">
            <div class="table-wrap">
              <table id="partsTable">
                <thead><tr><th>Descripción</th><th>Cantidad</th><th>Unidad</th><th>Observaciones</th><th class="no-print">Acción</th></tr></thead>
                <tbody></tbody>
              </table>
            </div>
            <br />
            <button class="btn secondary small" onclick="addPartRow()">+ Agregar refacción</button>
          </div>
        </section>

        <section class="card">
          <h2>7. Evidencia fotográfica</h2>
          <div class="card-body">
            <input id="photoInput" type="file" accept="image/*" multiple />
            <p class="hint">Puedes subir fotos del antes, durante y después. El sistema las comprime para que el reporte no sea demasiado pesado.</p>
            <div class="photo-grid" id="photoGrid"></div>
          </div>
        </section>

        <section class="card">
          <h2>8. Firmas de conformidad</h2>
          <div class="card-body grid">
            <div class="col-6">
              <label>Firma del ingeniero de servicio</label>
              <div class="signature-box">
                <canvas class="signature" id="techSignature"></canvas>
                <button class="btn secondary small" onclick="clearSignature('tech')">Limpiar firma</button>
              </div>
            </div>
            <div class="col-6">
              <label>Firma del cliente / responsable</label>
              <div class="signature-box">
                <canvas class="signature" id="clientSignature"></canvas>
                <button class="btn secondary small" onclick="clearSignature('client')">Limpiar firma</button>
              </div>
              <br />
              <button class="btn accent" onclick="showMobileSignatureQR()">Generar QR para firma en celular</button>
              <button class="btn secondary" onclick="importMobileSignature()">Importar código de firma móvil</button>
              <div id="mobileQrHelp" class="hint"></div>
              <div class="qr-box" id="mobileSignQR"></div>
            </div>
          </div>
        </section>
      </main>

      <aside class="side">
        <section class="card">
          <h2>Acciones</h2>
          <div class="card-body">
            <button class="btn ok" onclick="saveReport()">Guardar reporte</button>
            <button class="btn accent" onclick="generatePDF()">Generar PDF</button>
            <button class="btn secondary" onclick="exportExcel()">Exportar base de datos Excel</button>
            <button class="btn secondary" onclick="exportJsonBackup()">Respaldar base completa JSON</button>
            <button class="btn secondary" onclick="newReport()">Nuevo reporte</button>
            <button class="btn danger" onclick="deleteCurrentReport()">Eliminar reporte actual</button>
            <div class="divider"></div>
            <label>QR de validación del reporte</label>
            <div class="qr-box" id="reportQR"></div>
            <p class="hint">Este QR se integra al PDF. Puede contener el resumen del reporte o una liga si configuras una URL pública.</p>
          </div>
        </section>

        <section class="card">
          <h2>Reportes guardados</h2>
          <div class="card-body">
            <div id="reportList" class="report-list"></div>
          </div>
        </section>
      </aside>
    </div>
  </div>

  <div id="mobileSignApp" class="mobile-sign">
    <section class="card">
      <h2>Firma del cliente desde celular</h2>
      <div class="card-body">
        <div class="grid">
          <div class="col-6"><label>Folio</label><input id="mobileFolio" readonly /></div>
          <div class="col-6"><label>Nombre de quien firma</label><input id="mobileSignerName" placeholder="Nombre completo" /></div>
          <div class="col-12">
            <label>Firma en pantalla</label>
            <div class="signature-box"><canvas class="signature" id="mobileSignature"></canvas></div>
          </div>
          <div class="col-6"><button class="btn secondary" onclick="clearMobileSignature()">Limpiar firma</button></div>
          <div class="col-6"><button class="btn ok" onclick="makeMobileSignatureCode()">Generar código de firma</button></div>
          <div class="col-12">
            <label>Código de firma para enviar al técnico</label>
            <textarea class="code-area" id="mobileSignatureCode" readonly placeholder="Aquí aparecerá el código. Cópialo y envíalo al técnico para importarlo al reporte."></textarea>
            <p class="hint">Esta versión HTML local no usa servidor. Por eso la firma del celular se envía al reporte pegando este código. En la versión con Supabase/Vercel, este paso puede quedar automático.</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    const STORAGE_KEY = 'service_reports_db_v1';
    const SETTINGS_KEY = 'service_report_settings_v1';
    let photos = [];
    let currentReportId = null;
    let logoDataUrl = '';
    let clientImportedSignature = null;

    const $ = (id) => document.getElementById(id);

    const fields = [
      'companyName','companyTagline','companyPhone','companyEmail','publicUrl','companyAddress',
      'folio','reportDate','preparedBy','finalStatus','clientName','clientReceiver','clientAddress','servicePlace',
      'clientPhone','clientEmail','clientLocation','instrument','brand','model','serial','serviceType','priority',
      'startTime','endTime','nextMaintenance','score','problemReport','serviceDescription','observations'
    ];

    function toast(message) {
      const el = $('toast');
      el.textContent = message;
      el.style.display = 'block';
      setTimeout(() => el.style.display = 'none', 3300);
    }

    function todayDate() {
      return new Date().toISOString().slice(0,10);
    }


    function uid() {
      if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
      return 'id-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
    }

    function safeName(text) {
      return String(text || '').replace(/[\\/:*?"<>|]/g, '-').replace(/\s+/g, '_').slice(0, 80);
    }

    function loadReports() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
      catch { return []; }
    }

    function storeReports(reports) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(reports));
    }

    function loadSettings() {
      try { return JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}'); }
      catch { return {}; }
    }

    function storeSettings() {
      const settings = {
        companyName: $('companyName').value,
        companyTagline: $('companyTagline').value,
        companyPhone: $('companyPhone').value,
        companyEmail: $('companyEmail').value,
        companyAddress: $('companyAddress').value,
        publicUrl: $('publicUrl').value,
        logoDataUrl
      };
      localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
    }

    function applySettings() {
      const s = loadSettings();
      ['companyName','companyTagline','companyPhone','companyEmail','companyAddress','publicUrl'].forEach(k => {
        if (s[k]) $(k).value = s[k];
      });
      logoDataUrl = s.logoDataUrl || '';
    }

    function generateFolio() {
      const year = new Date().getFullYear();
      const reports = loadReports();
      const nums = reports.map(r => {
        const m = String(r.folio || '').match(/(\d+)$/);
        return m ? Number(m[1]) : 0;
      });
      const next = (Math.max(0, ...nums) + 1).toString().padStart(4, '0');
      return `ST-${year}-${next}`;
    }

    function collectData() {
      const data = {};
      fields.forEach(id => data[id] = $(id).value || '');
      data.id = currentReportId || uid();
      data.photos = photos;
      data.logoDataUrl = logoDataUrl;
      data.parts = collectParts();
      data.techSignature = getSignatureData('techSignature');
      data.clientSignature = clientImportedSignature || getSignatureData('clientSignature');
      data.createdAt = data.createdAt || new Date().toISOString();
      data.updatedAt = new Date().toISOString();
      return data;
    }

    function fillData(data) {
      currentReportId = data.id || uid();
      fields.forEach(id => { if ($(id)) $(id).value = data[id] || ''; });
      photos = Array.isArray(data.photos) ? data.photos : [];
      logoDataUrl = data.logoDataUrl || logoDataUrl || '';
      clientImportedSignature = data.clientSignature || null;
      fillParts(data.parts || []);
      drawSignatureFromData('techSignature', data.techSignature);
      drawSignatureFromData('clientSignature', data.clientSignature);
      renderPhotos();
      updateStatus();
      updateQR();
    }

    function updateStatus() {
      $('currentStatus').textContent = `${$('folio').value || 'Sin folio'} · ${$('clientName').value || 'Sin cliente'} · ${$('finalStatus').value || ''}`;
    }

    function saveReport() {
      storeSettings();
      const data = collectData();
      currentReportId = data.id;
      const reports = loadReports();
      const idx = reports.findIndex(r => r.id === data.id);
      if (idx >= 0) reports[idx] = data;
      else reports.push(data);
      storeReports(reports);
      renderReportList();
      updateStatus();
      updateQR();
      toast('Reporte guardado en la base local del navegador.');
    }

    function newReport() {
      currentReportId = null;
      clientImportedSignature = null;
      fields.forEach(id => { if ($(id) && !id.startsWith('company')) $(id).value = ''; });
      $('reportDate').value = todayDate();
      $('folio').value = generateFolio();
      $('score').value = '100%';
      photos = [];
      renderPhotos();
      fillParts([]);
      clearSignature('tech');
      clearSignature('client');
      updateStatus();
      updateQR();
      toast('Reporte nuevo listo para capturar.');
    }

    function deleteCurrentReport() {
      if (!currentReportId) { toast('No hay un reporte guardado seleccionado.'); return; }
      if (!confirm('¿Eliminar el reporte actual de la base local?')) return;
      const reports = loadReports().filter(r => r.id !== currentReportId);
      storeReports(reports);
      renderReportList();
      newReport();
    }

    function renderReportList() {
      const list = $('reportList');
      const reports = loadReports().sort((a,b) => String(b.updatedAt).localeCompare(String(a.updatedAt)));
      if (!reports.length) {
        list.innerHTML = '<div class="report-row"><span>No hay reportes guardados todavía.</span></div>';
        return;
      }
      list.innerHTML = reports.map(r => `
        <div class="report-row" onclick="loadReportById('${r.id}')">
          <strong>${escapeHtml(r.folio || 'Sin folio')} · ${escapeHtml(r.clientName || 'Sin cliente')}</strong>
          <span>${escapeHtml(r.reportDate || '')} · ${escapeHtml(r.brand || '')} ${escapeHtml(r.model || '')}</span>
        </div>
      `).join('');
    }

    function loadReportById(id) {
      const report = loadReports().find(r => r.id === id);
      if (report) fillData(report);
      toast('Reporte cargado.');
    }

    function escapeHtml(text) {
      return String(text || '').replace(/[&<>'"]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[m]));
    }

    function collectParts() {
