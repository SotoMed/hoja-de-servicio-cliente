    }

    function generatePrintablePDF() {
      const data = collectData();
      const win = window.open('', '_blank');
      if (!win) {
        toast('El navegador bloqueó la ventana del PDF. Permite ventanas emergentes para este archivo.');
        return;
      }
      win.document.open();
      win.document.write(printableReportHTML(data));
      win.document.close();
      toast('Se abrió la vista para guardar como PDF. Elige “Guardar como PDF”.');
