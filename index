    function importMobileSignature() {
      const code = prompt('Pega aquí el código de firma móvil que envió el cliente:');
      if (!code) return;
      try {
        const raw = decodeURIComponent(escape(atob(code.trim())));
        const obj = JSON.parse(raw);
