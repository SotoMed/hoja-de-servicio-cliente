    function setupSignatureCanvas(canvasId) {
      const canvas = $(canvasId);
      const ctx = canvas.getContext('2d');
      let drawing = false;
      function resize() {
        const ratio = window.devicePixelRatio || 1;
        const rect = canvas.getBoundingClientRect();
        const old = canvas.toDataURL();
        canvas.width = Math.round(rect.width * ratio);
        canvas.height = Math.round(rect.height * ratio);
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.lineWidth = 2;
        ctx.strokeStyle = '#111827';
        const img = new Image();
        img.onload = () => { if (old && old.length > 100) ctx.drawImage(img, 0, 0, rect.width, rect.height); };
        img.src = old;
      }
      resize();
      window.addEventListener('resize', resize);
      const pos = (evt) => {
        const rect = canvas.getBoundingClientRect();
        return { x: evt.clientX - rect.left, y: evt.clientY - rect.top };
      };
      canvas.addEventListener('pointerdown', (evt) => { drawing = true; canvas.setPointerCapture(evt.pointerId); const p = pos(evt); ctx.beginPath(); ctx.moveTo(p.x, p.y); });
      canvas.addEventListener('pointermove', (evt) => { if (!drawing) return; const p = pos(evt); ctx.lineTo(p.x, p.y); ctx.stroke(); });
      canvas.addEventListener('pointerup', () => drawing = false);
      canvas.addEventListener('pointerleave', () => drawing = false);
    }

    function clearCanvas(id) {
      const canvas = $(id);
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    function clearSignature(which) {
      if (which === 'tech') clearCanvas('techSignature');
      if (which === 'client') { clearCanvas('clientSignature'); clientImportedSignature = null; }
    }

    function getSignatureData(canvasId) {
      const canvas = $(canvasId);
      return canvas.toDataURL('image/png');
    }

    function drawSignatureFromData(canvasId, dataUrl) {
      clearCanvas(canvasId);
      if (!dataUrl) return;
      const canvas = $(canvasId);
      const ctx = canvas.getContext('2d');
      const img = new Image();
      img.onload = () => {
        const rect = canvas.getBoundingClientRect();
        ctx.drawImage(img, 0, 0, rect.width, rect.height);
      };
      img.src = dataUrl;
    }

