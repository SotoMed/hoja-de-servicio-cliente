    function addPartRow(part = {}) {
      const tbody = document.querySelector('#partsTable tbody');
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><input class="part-description" value="${escapeAttr(part.description || '')}" placeholder="Ej. Filtro, lámpara, tubería" /></td>
        <td><input class="part-qty" value="${escapeAttr(part.qty || '')}" placeholder="1" /></td>
        <td><input class="part-unit" value="${escapeAttr(part.unit || 'Pieza')}" /></td>
